@{
    SchemaVersion = 1
    Checks = @(
        @{ Id='tenant-info'; Switch='tenantinfo'; File='Invoke-TenantInfoCheck.ps1'; Func='Invoke-Check-TenantInfo'; Title='Tenant / Organization Overview'; Description='Tenant overview: organization details, verified domains and licenses'; Scopes=@('Organization.Read.All'); P1=$false; P2=$false }
        @{ Id='privileged-roles'; Switch='privroles'; File='Invoke-PrivRolesCheck.ps1'; Func='Invoke-Check-PrivRoles'; Title='Privileged Roles - Permanent vs Eligible'; Description='MAIN CHECK: who holds admin roles permanently vs only when activated (just-in-time roles need Entra ID P2)'; Scopes=@('RoleManagement.Read.Directory'); P1=$false; P2=$false }
        @{ Id='directory-roles'; Switch='directoryroles'; File='Invoke-DirectoryRolesCheck.ps1'; Func='Invoke-Check-DirectoryRoles'; Title='Privileged Assignment Volume'; Description='How many Global Administrators and other admin-role holders the tenant has'; Scopes=@('RoleManagement.Read.Directory'); P1=$false; P2=$false }
        @{ Id='accounts'; Switch='accounts'; File='Invoke-AccountsCheck.ps1'; Func='Invoke-Check-Accounts'; Title='Account Hygiene'; Description='Account clean-up: disabled accounts that are old or still licensed, passwords that never expire, no manager'; Scopes=@('User.Read.All'); P1=$false; P2=$false }
        @{ Id='staleusers'; Switch='staleusers'; File='Invoke-StaleUsersCheck.ps1'; Func='Invoke-Check-StaleUsers'; Title='Stale / Inactive Users'; Description='Users who have not signed in for a long time, or never (needs Entra ID P1)'; Scopes=@('User.Read.All', 'AuditLog.Read.All'); P1=$true; P2=$false }
        @{ Id='guests'; Switch='guests'; File='Invoke-GuestsCheck.ps1'; Func='Invoke-Check-Guests'; Title='Guest / External Governance'; Description='Guest (external) users: who may invite them, invitations never accepted, guests with admin roles'; Scopes=@('User.Read.All'); P1=$false; P2=$false }
        @{ Id='mfa'; Switch='mfa'; File='Invoke-MfaCheck.ps1'; Func='Invoke-Check-Mfa'; Title='MFA Capability & Method Strength'; Description='Multi-factor authentication (MFA): who has registered it and how strong the methods are, admins first'; Scopes=@('AuditLog.Read.All'); P1=$false; P2=$false }
        @{ Id='legacyauth'; Switch='legacyauth'; File='Invoke-LegacyAuthCheck.ps1'; Func='Invoke-Check-LegacyAuth'; Title='Legacy Authentication Usage'; Description='Sign-ins with old protocols that cannot do MFA (legacy authentication; reads sign-in logs, needs P1)'; Scopes=@('AuditLog.Read.All'); P1=$true; P2=$false }
        @{ Id='tenantposture'; Switch='tenantposture'; File='Invoke-TenantPostureCheck.ps1'; Func='Invoke-Check-TenantPosture'; Title='Security Defaults & Consent Settings'; Description='Tenant-wide settings: Security Defaults, and what ordinary users may do (register apps, approve app access)'; Scopes=@('Policy.Read.All'); P1=$false; P2=$false }
        @{ Id='capolicies'; Switch='capolicies'; File='Invoke-CAPoliciesCheck.ps1'; Func='Invoke-Check-CAPolicies'; Title='Conditional Access Posture'; Description='Conditional Access sign-in rules (MFA, risk, locations) - enter break-glass accounts in Step 4 first'; Scopes=@('Policy.Read.All'); P1=$false; P2=$false }
        @{ Id='riskyusers'; Switch='riskyusers'; File='Invoke-RiskyUsersOnlyCheck.ps1'; Func='Invoke-Check-RiskyUsersOnly'; Title='Identity Protection (Risky Users)'; Description='Users Microsoft flags as risky (possibly compromised) and recent risk detections (needs Entra ID P2)'; Scopes=@('IdentityRiskyUser.Read.All'); P1=$false; P2=$true }
        @{ Id='riskyserviceprincipals'; Switch='riskyserviceprincipals'; File='Invoke-RiskyServicePrincipalsCheck.ps1'; Func='Invoke-Check-RiskyServicePrincipals'; Title='Identity Protection (Risky Service Principals)'; Description='Apps and service principals Microsoft flags as risky (needs a Workload Identities Premium license)'; Scopes=@('IdentityRiskyServicePrincipal.Read.All'); P1=$false; P2=$false }
        @{ Id='apps'; Switch='apps'; File='Invoke-AppsCheck.ps1'; Func='Invoke-Check-Apps'; Title='App / Service Principal Hygiene'; Description='Apps with powerful permissions: who owns them, unverified publishers, apps with no owner'; Scopes=@('Application.Read.All'); P1=$false; P2=$false }
        @{ Id='appcredentials'; Switch='appcredentials'; File='Invoke-AppCredentialsCheck.ps1'; Func='Invoke-Check-AppCredentials'; Title='App Registration Credential Expiry'; Description='App registration secrets and certificates that have expired or expire soon'; Scopes=@('Application.Read.All'); P1=$false; P2=$false }
        @{ Id='consentgrants'; Switch='consentgrants'; File='Invoke-ConsentGrantsCheck.ps1'; Func='Invoke-Check-ConsentGrants'; Title='OAuth2 Consent Grants'; Description='Access that users or admins granted to apps (consent grants), high-impact grants first'; Scopes=@('Directory.Read.All'); P1=$false; P2=$false }
        @{ Id='devices'; Switch='devices'; File='Invoke-DevicesCheck.ps1'; Func='Invoke-Check-Devices'; Title='Stale / Unmanaged Devices'; Description='Devices that have not signed in for a long time, are not managed, or are not compliant'; Scopes=@('Device.Read.All'); P1=$false; P2=$false }
        @{ Id='trusts'; Switch='trusts'; File='Invoke-TrustsCheck.ps1'; Func='Invoke-Check-Trusts'; Title='Cross-Tenant Access & B2B Trust'; Description='Trust in other organizations'' Microsoft tenants: their MFA and device checks, guest access (cross-tenant access)'; Scopes=@('Policy.Read.All'); P1=$false; P2=$false }
        @{ Id='recentchanges'; Switch='recentchanges'; File='Invoke-RecentChangesCheck.ps1'; Func='Invoke-Check-RecentChanges'; Title='Recently Created Users / Groups'; Description='Users and groups created recently, and recent admin-role changes (from the audit log)'; Scopes=@('User.Read.All', 'AuditLog.Read.All'); P1=$false; P2=$false }
        @{ Id='tenanthealth'; Switch='tenanthealth'; File='Invoke-TenantHealthCheck.ps1'; Func='Invoke-Check-TenantHealth'; Title='Directory-Sync / PHS Health'; Description='Sync from on-premises Active Directory: last sync, Password Hash Sync, sync settings (hybrid only)'; Scopes=@('Organization.Read.All', 'OnPremDirectorySynchronization.Read.All'); P1=$false; P2=$false }
        @{ Id='pimpolicies'; Switch='pimpolicies'; File='Invoke-PimPoliciesCheck.ps1'; Func='Invoke-Check-PimPolicies'; Title='PIM Role-Management Policy Quality'; Description='Rules for activating admin roles in Privileged Identity Management (PIM): MFA, approval, reason, time limit (needs P2)'; Scopes=@('RoleManagementPolicy.Read.Directory'); P1=$false; P2=$true }
        @{ Id='breakglass'; Switch='breakglass'; File='Invoke-BreakGlassCheck.ps1'; Func='Invoke-Check-BreakGlass'; Title='Emergency-Access (Break-Glass) Health'; Description='Emergency-access (break-glass) admin accounts: are they set up and ready - enter them in Step 4'; Scopes=@('User.Read.All', 'RoleManagement.Read.Directory'); P1=$false; P2=$false }
        @{ Id='authmethodpolicy'; Switch='authmethodpolicy'; File='Invoke-AuthMethodPolicyCheck.ps1'; Func='Invoke-Check-AuthMethodPolicy'; Title='Authentication Methods Policy'; Description='Allowed sign-in methods: weak ones (text message, voice call) vs phishing-resistant (security keys)'; Scopes=@('Policy.Read.All'); P1=$false; P2=$false }
        @{ Id='accesspaths'; Switch='accesspaths'; File='Invoke-AccessPathsCheck.ps1'; Func='Invoke-Check-AccessPaths'; Title='Effective Access / Attack Paths'; Description='Hidden routes to admin rights: duplicate role paths, owners of groups and apps that grant admin rights'; Scopes=@('RoleManagement.Read.Directory', 'Group.Read.All'); P1=$false; P2=$false }
        @{ Id='staleapps'; Switch='staleapps'; File='Invoke-StaleAppsCheck.ps1'; Func='Invoke-Check-StaleApps'; Title='Stale / Unused Applications'; Description='Apps nobody has used for a long time, especially ones that still have valid secrets (needs P1)'; Scopes=@('Application.Read.All', 'AuditLog.Read.All'); P1=$true; P2=$false }
        @{ Id='recommendations'; Switch='recommendations'; File='Invoke-EntraRecommendationsCheck.ps1'; Func='Invoke-Check-EntraRecommendations'; Title='Microsoft Entra Recommendations'; Description='Microsoft Entra recommendations that are still open, high-impact ones first'; Scopes=@('DirectoryRecommendations.Read.All'); P1=$false; P2=$false }
        @{ Id='securescore'; Switch='securescore'; File='Invoke-SecureScoreCheck.ps1'; Func='Invoke-Check-SecureScore'; Title='Microsoft Identity Secure Score'; Description='Microsoft Identity Secure Score and the improvement actions not yet done'; Scopes=@('SecurityEvents.Read.All'); P1=$false; P2=$false }
        @{ Id='accessreviews'; Switch='accessreviews'; File='Invoke-AccessReviewsCheck.ps1'; Func='Invoke-Check-AccessReviews'; Title='Access Review Governance'; Description='Access reviews: what is reviewed, how often, by whom, and what happens to the results'; Scopes=@('AccessReview.Read.All'); P1=$false; P2=$false }
        @{ Id='identitygovernance'; Switch='identitygovernance'; File='Invoke-IdentityGovernanceCheck.ps1'; Func='Invoke-Check-IdentityGovernance'; Title='Identity Governance Controls'; Description='Access packages, lifecycle workflows, Terms of Use and PIM for Groups (may need extra licenses)'; Scopes=@(); P1=$false; P2=$false }
        @{ Id='authrecovery'; Switch='authrecovery'; File='Invoke-AuthRecoveryCheck.ps1'; Func='Invoke-Check-AuthRecovery'; Title='Authentication Recovery Readiness'; Description='Self-service password reset and account recovery, MFA registration campaign, system-preferred MFA'; Scopes=@(); P1=$false; P2=$false }
        @{ Id='groupgovernance'; Switch='groupgovernance'; File='Invoke-GroupGovernanceCheck.ps1'; Func='Invoke-Check-GroupGovernance'; Title='Group Governance'; Description='Groups: missing owners, groups that can hold admin roles, dynamic membership rules, expiry settings'; Scopes=@('Group.Read.All'); P1=$false; P2=$false }
        @{ Id='externaldelegation'; Switch='externaldelegation'; File='Invoke-ExternalDelegationCheck.ps1'; Func='Invoke-Check-ExternalDelegation'; Title='External Delegation & Partner Trust'; Description='Outside access: partner admin relationships (GDAP), guest sponsors and partner tenant settings'; Scopes=@(); P1=$false; P2=$false }
        @{ Id='federationhealth'; Switch='federationhealth'; File='Invoke-FederationHealthCheck.ps1'; Func='Invoke-Check-FederationHealth'; Title='Federation & Hybrid Authentication Health'; Description='Federated domains: signing-certificate expiry, sign-in endpoints and hybrid sign-in settings'; Scopes=@('Domain.Read.All'); P1=$false; P2=$false }
        @{ Id='workloadcredentials'; Switch='workloadcredentials'; File='Invoke-WorkloadCredentialsCheck.ps1'; Func='Invoke-Check-WorkloadCredentials'; Title='Workload Identity Credentials'; Description='Secrets, certificates and federated credentials on apps and service principals, and credential policies'; Scopes=@('Application.Read.All'); P1=$false; P2=$false }
        @{ Id='enterpriseapps'; Switch='enterpriseapps'; File='Invoke-EnterpriseAppGovernanceCheck.ps1'; Func='Invoke-Check-EnterpriseAppGovernance'; Title='Enterprise Application Governance'; Description='Enterprise apps: owners, who is allowed to use them, and high-impact permissions'; Scopes=@('Application.Read.All'); P1=$false; P2=$false }
        @{ Id='monitoring'; Switch='monitoring'; File='Invoke-MonitoringCheck.ps1'; Func='Invoke-Check-Monitoring'; Title='Identity Monitoring & Alert Coverage'; Description='Logging and alerting: are sign-in and audit logs kept and exported, and do alert rules exist'; Scopes=@('AuditLog.Read.All'); P1=$false; P2=$false }
        @{ Id='changemonitoring'; Switch='changemonitoring'; File='Invoke-ChangeMonitoringCheck.ps1'; Func='Invoke-Check-ChangeMonitoring'; Title='Security-Sensitive Change Monitoring'; Description='Recent security-sensitive changes to users, roles, policies, apps, consent and federation'; Scopes=@('AuditLog.Read.All'); P1=$false; P2=$false }
    )
}